{
  "name": "better-nj-ws",
  "version": "1.0.0",
  "description": "enhancement from node-ws",
  "main": "appws.js",
  "type": "commonjs",
  "scripts": {
    "start": "node appws.js",
    "configs": "node tools/render-configs.mjs",
    "configs:check": "node tools/render-configs.mjs --check",
    "creds": "node tools/credentials.mjs",
    "creds:status": "node tools/credentials.mjs --status",
    "creds:push": "node tools/credentials.mjs --push",
    "creds:env": "node tools/credentials.mjs --deno-env",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "qr": "node tools/qr.mjs",
    "qr:serve": "node tools/qr.mjs serve"
  },
  "author": "cocaococao",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "wrangler": "^4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
