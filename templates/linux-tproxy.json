{
  "dns": {
    "tag": "dns-inbound",
    "servers": [
      "tcp://1.1.1.1"
    ]
  },
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "dns-inbound"
        ],
        "outboundTag": "vless"
      },
      {
        "network": "tcp,udp",
        "port": "53",
        "outboundTag": "dns-outbound"
      },
      {
        "network": "udp",
        "outboundTag": "${UDP_OUTBOUND}"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "tproxy-in",
      "listen": "127.0.0.1",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "${HOST}",
            "port": 443,
            "users": [
              {
                "id": "${UUID}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "${HOST}",
          "certificates": [
            {
              "usage": "verify",
              "certificate": [
                "${CA_PEM_LINES}"
              ]
            }
          ]
        },
        "wsSettings": {
          "path": "${WSPATH}",
          "host": "${HOST}"
        },
        "sockopt": {
          "mark": 2
        }
      },
      "mux": {
        "enabled": true,
        "concurrency": 8,
        "xudpConcurrency": 1024,
        "xudpProxyUDP443": "${XUDP_443}"
      }
    },
    {
      "tag": "dns-outbound",
      "protocol": "dns"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
