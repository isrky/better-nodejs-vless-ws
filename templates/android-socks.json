{
  "routing": {
    "rules": [
      {
        "network": "tcp,udp",
        "port": "53",
        "outboundTag": "vless"
      },
      {
        "network": "udp",
        "port": "443",
        "outboundTag": "${QUIC_OUTBOUND}"
      },
      {
        "network": "udp",
        "outboundTag": "${UDP_OUTBOUND}"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "vless",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "${HOST}",
            "port": 443,
            "users": [
              {
                "id": "${UUID}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "${HOST}",
          "certificates": [
            {
              "usage": "verify",
              "certificate": [
                "${CA_PEM_LINES}"
              ]
            }
          ]
        },
        "wsSettings": {
          "path": "${WSPATH}",
          "host": "${HOST}"
        },
        "sockopt": {
          "domainStrategy": "UseIPv4"
        }
      },
      "mux": {
        "enabled": true,
        "concurrency": 8,
        "xudpConcurrency": 1024,
        "xudpProxyUDP443": "${XUDP_443}"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
