# Compose env template — copy to `.env` next to compose.yaml and fill in.
# On your own machine `npm run creds:docker` writes local/docker.env containing
# the two group keys; paste that block, then add the deployment config below.
# The real .env is gitignored (secrets, never committed).
#
# Preferred (see CREDENTIALS.md § Encrypted secrets): let the container decrypt
# the committed src/node/secrets.enc.json on boot — nothing to re-paste when a
# credential changes:
#   SECRETS_KEY_COMMON=…      (npm run creds:keys)
#   SECRETS_KEY_SERVER=…
# UUID / WSPATH / ADMIN_TOKEN / PROVISION_SECRET / USERS below are the legacy
# plaintext alternative. PUBLIC_HOST / FRONT_SNI / FRONT_CERT_PIN stay
# per-deployment either way and are never included in the key export.

# Tunnel credential; `npm run creds` generates one (never ship the repo default).
UUID=

# Secret WebSocket path the tunnel listens on (leading slash).
WSPATH=/your-secret-path

# Public domain nginx serves this stack on — drives the URLs the container
# prints at startup and the hosts written into generated client configs.
PUBLIC_HOST=your.domain.example

# Unset = /admin-stats stays hidden behind the decoy page.
# Set = dashboard at https://<PUBLIC_HOST>/admin-stats?token=<ADMIN_TOKEN>
ADMIN_TOKEN=

# Key for invite links / per-user provisioning (optional feature).
PROVISION_SECRET=

# Comma-separated user labels for per-user stats (optional).
USERS=

# Domain fronting: allowed high-reputation SNI to spoof (optional; see README).
FRONT_SNI=

# DNS-over-HTTPS resolver URL (optional; unset = system resolver).
# DOH_URL=

# Static cert pin when the container can't self-probe its edge (`npm run creds:pin`).
# FRONT_CERT_PIN=
