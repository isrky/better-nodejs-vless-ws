node_modules/
.wrangler/
.dev.vars

# Credentials and the configs rendered from them. Templates live in
# templates/ and hold placeholders only; `npm run configs` renders into here.
local/

# The interception CA is public, but it is DER and nothing reads it at
# runtime — src/node/interceptca.js carries the PEM the builds actually use.
*.cer

# Third-party MEB network analysis (arinc9, public research) — not ours to redistribute.
restrictions/

# The compose env file on a VPS — secrets, never committed. The repo itself
# holds no .env; `npm run creds:docker` writes local/docker.env to paste in.
.env

# Local AI-tooling scratch dir, not part of the project.
.commandcode/
